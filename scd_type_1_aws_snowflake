-- 6. Load data from S3
COPY INTO STAGE1_EMPLOYEE
FROM @EMPLOYEE_S3_STAGE
FILE_FORMAT = (
    TYPE = CSV
    FIELD_DELIMITER = ','
    SKIP_HEADER = 1
);

-- 7. Stored Procedure
CREATE OR REPLACE PROCEDURE LOAD_EMPLOYEE()
RETURNS VARCHAR
LANGUAGE SQL
AS
$$
BEGIN

    DELETE FROM EMPLOYEE
    WHERE EMPNO IN (
        SELECT DISTINCT EMPNO
        FROM STAGE1_EMPLOYEE
    );

    INSERT INTO EMPLOYEE
    SELECT *
    FROM STAGE1_EMPLOYEE;

    RETURN 'EMPLOYEE LOAD COMPLETED';

END;
$$;

-- 8. Execute procedure
CALL LOAD_EMPLOYEE();

